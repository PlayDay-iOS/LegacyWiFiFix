#!/bin/sh
# Restart the process that hosts the RSN IE parser so Substrate injects the
# tweak into the new instance.  launchd respawns both daemons (KeepAlive).
if [ -x /usr/libexec/wifid ] || [ -x /usr/sbin/wifid ]; then
    # iOS 5+: wifid is a standalone daemon.
    killall wifid 2>/dev/null || true
else
    # iOS 3-4: WiFi logic lives in WiFiManager.bundle, a SystemConfiguration
    # plugin loaded by configd.
    killall configd 2>/dev/null || true
fi
exit 0
