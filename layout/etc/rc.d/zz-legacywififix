#!/bin/sh
# Boot-time activation hook.
#
# The zz- prefix makes this sort after /etc/rc.d/substrate: jailbreaks run
# rc.d entries in name order, and wifid must restart after Substrate is up.
#
# iOS 5+: wifid is a standalone daemon.  Some jailbreaks activate Substrate
# after launchd has started services, so wifid may already be running without
# the tweak.  Killing it forces launchd to respawn it with injection.
#
# iOS 3-4: WiFi logic lives in WiFiManager.bundle loaded by configd.  Those
# jailbreaks inject Substrate through the launchd job environment before
# configd starts, so no action is required here.
if [ -x /usr/libexec/wifid ] || [ -x /usr/sbin/wifid ]; then
    killall wifid 2>/dev/null || true
fi
